{
	"name": "getkirby/discord",
	"description": "Simple Discord webhook wrapper",
	"license": "MIT",
	"type": "kirby-plugin",
	"version": "1.1.0",
	"keywords": [
		"kirby",
		"kirby4",
		"kirby5",
		"kirby6",
		"cms",
		"webhook",
		"discord",
		"notification"
	],
	"authors": [
		{
			"name": "Kirby Team",
			"email": "mail@getkirby.com"
		}
	],
	"homepage": "https://getkirby.com",
	"support": {
		"email": "support@getkirby.com",
		"issues": "https://github.com/getkirby/discord/issues",
		"forum": "https://forum.getkirby.com",
		"source": "https://github.com/getkirby/discord"
	},
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0",
		"getkirby/composer-installer": "^1.2.1"
	},
	"require-dev": {
		"getkirby/cms": "^5.6",
		"pestphp/pest": "^3.7"
	},
	"config": {
		"allow-plugins": {
			"getkirby/composer-installer": true,
			"pestphp/pest-plugin": true
		},
		"optimize-autoloader": true
	},
	"extra": {
		"installer-name": "discord",
		"kirby": {
			"compatible": "^4.0 || ^5.0 || ^6.0"
		},
		"kirby-cms-path": false
	},
	"scripts": {
		"analyze": [
			"@analyze:composer",
			"@analyze:psalm"
		],
		"analyze:composer": "composer validate --strict --no-check-version --no-check-all",
		"analyze:psalm": "cpx vimeo/psalm:6.20.1",
		"ci": [
			"@fix",
			"@analyze",
			"@test"
		],
		"fix": "cpx getkirby/php-cs:^0.2 fix",
		"test": "./vendor/bin/pest"
	}
}
