<?xml version="1.0"?>
<psalm
	errorLevel="1"
	findUnusedCode="false"
	findUnusedPsalmSuppress="true"
	resolveFromConfigFile="true"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
	<projectFiles>
		<directory name="src" />
		<file name="index.php" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>

	<issueHandlers>
		<!-- Don't require final classes as developers may extend the plugin's classes -->
		<ClassMustBeFinal errorLevel="suppress" />

		<!-- Don't warn about duplicate array keys as Psalm will throw false positive when unpacking arrays -->
		<DuplicateArrayKey errorLevel="suppress" />

		<!-- Don't warn about `new static` in the `from()` methods as child classes are expected to keep the constructor signature -->
		<UnsafeInstantiation errorLevel="suppress" />
	</issueHandlers>
</psalm>
